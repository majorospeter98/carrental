  "narrative": {
    "northStar": "Night",
    "overview": "City after dark: the car comes out of a deep blue-black, and amber marks what you can act on. One car holds the stage at a time, photographed full width, with its name and the trip total over it. Everything else is quiet and flat.",
    "keyCharacteristics": [
      "Dark only. No glows or coloured shadows.",
      "Large condensed uppercase names and prices against calm body text.",
      "Hairline dividers instead of cards in lists.",
      "One authored motion: the stage photo fades up from dark."
    ],
    "rules": [
      {
        "name": "The Amber Means Act Rule",
        "body": "Amber marks what you can act on, what you picked and what it costs. Never decoration.",
        "section": "colors"
      },
      {
        "name": "The Shape As Well Rule",
        "body": "A state is never told by colour alone: booked days are hatched, errors carry text.",
        "section": "colors"
      },
      {
        "name": "The No Glow Rule",
        "body": "No glows and no coloured shadows.",
        "section": "elevation"
